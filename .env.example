# =============================================================================
# Automated Data Analyst — Environment Configuration Template
# Copy this file to ".env" and fill in your local values.
# NEVER commit the real ".env" file to source control.
# =============================================================================

# ---- PostgreSQL Connection ----
# Hostname or IP address of your PostgreSQL server (default: localhost)
DATABASE_HOST=localhost

# Port where PostgreSQL is listening (default: 5432)
DATABASE_PORT=5432

# PostgreSQL username (default: postgres)
DATABASE_USER=postgres

# PostgreSQL password for the user above
DATABASE_PASSWORD=YOUR_LOCAL_POSTGRES_PASSWORD

# Name of the target PostgreSQL database.
# Leave blank to create/select one later using the in-app PostgreSQL wizard.
DATABASE_NAME=

# ---- Optional Groq AI Layer ("Ask Your Data") ----
# API key obtained from Groq Console (https://console.groq.com/keys).
# Paste your Groq API key after the '=' sign below.
# Leave blank to run the application with AI features gracefully disabled.
GROQ_API_KEY=

# Supported Groq model name (e.g. openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# ---- Application Configuration ----
# Local use defaults to development. Public deployment requires all three settings below.
APP_ENV=development
APP_USERNAME=analyst
APP_PASSWORD=
DATABASE_QUERY_ROLE=

# Debug mode: true or false. Defaults to false in production to prevent leaking tracebacks.
DEBUG=false

# Maximum allowed file upload size in megabytes (default: 500)
UPLOAD_MAX_MB=500

# Comma-separated list of origins allowed to make cross-origin requests (CORS).
# Note: 'null' origin is excluded for security.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# Retention window for temporary files in data/uploads and data/cleaned (in hours).
UPLOAD_RETENTION_HOURS=24
